<?xml version="1.0" encoding="utf-8"?>
<MotionScene
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- START SET -->
    <ConstraintSet android:id="@+id/start">
        <Constraint android:id="@id/userAvatar"
            android:alpha="0"
            android:scaleX="0.6"
            android:scaleY="0.6"
            android:translationY="40dp"/>

        <Constraint android:id="@id/userName"
            android:alpha="0"
            android:translationY="40dp"/>

        <Constraint android:id="@id/userName2"
            android:alpha="0"
            android:translationY="40dp"/>

        <Constraint android:id="@id/questionText"
            android:alpha="0"
            android:scaleX="0.8"
            android:scaleY="0.8"
            android:translationY="30dp"/>

        <Constraint android:id="@id/moodEmoji"
            android:alpha="0"
            android:translationY="80dp"/>

        <Constraint android:id="@id/selectMoodButton"
            android:alpha="0"
            android:scaleX="0.9"
            android:scaleY="0.9"
            android:translationY="100dp"/>
    </ConstraintSet>

    <!-- END SET -->
    <ConstraintSet android:id="@+id/end">
        <Constraint android:id="@id/userAvatar"
            android:alpha="1"
            android:scaleX="1"
            android:scaleY="1"
            android:translationY="0dp"/>

        <Constraint android:id="@id/userName"
            android:alpha="1"
            android:translationY="0dp"/>

        <Constraint android:id="@id/userName2"
            android:alpha="1"
            android:translationY="0dp"/>

        <Constraint android:id="@id/questionText"
            android:alpha="1"
            android:scaleX="1"
            android:scaleY="1"
            android:translationY="0dp"/>

        <Constraint android:id="@id/moodEmoji"
            android:alpha="1"
            android:translationY="0dp"/>

        <Constraint android:id="@id/selectMoodButton"
            android:alpha="1"
            android:scaleX="1"
            android:scaleY="1"
            android:translationY="0dp"/>
    </ConstraintSet>

    <!-- TRANSITION -->
    <Transition
        android:id="@+id/transition"
        app:constraintSetStart="@id/start"
        app:constraintSetEnd="@id/end"
        app:duration="900"
        app:motionInterpolator="easeInOut">

        <KeyFrameSet>
            <!-- userAvatar: visible 0%–70% of timeline -->
            <KeyAttribute
                app:motionTarget="@id/userAvatar"
                app:framePosition="0"
                android:alpha="0" android:scaleX="0.6" android:scaleY="0.6"/>
            <KeyAttribute
                app:motionTarget="@id/userAvatar"
                app:framePosition="70"
                android:alpha="1" android:scaleX="1" android:scaleY="1"/>

            <!-- userName: starts at 15% -->
            <KeyAttribute app:motionTarget="@id/userName" app:framePosition="15"
                android:alpha="0" android:translationY="40dp"/>
            <KeyAttribute app:motionTarget="@id/userName" app:framePosition="80"
                android:alpha="1" android:translationY="0dp"/>

            <!-- userName2: starts at 25% -->
            <KeyAttribute app:motionTarget="@id/userName2" app:framePosition="25"
                android:alpha="0" android:translationY="40dp"/>
            <KeyAttribute app:motionTarget="@id/userName2" app:framePosition="85"
                android:alpha="1" android:translationY="0dp"/>

            <!-- questionText: starts at 35% -->
            <KeyAttribute app:motionTarget="@id/questionText" app:framePosition="35"
                android:alpha="0" android:scaleX="0.8" android:scaleY="0.8"
                android:translationY="30dp"/>
            <KeyAttribute app:motionTarget="@id/questionText" app:framePosition="90"
                android:alpha="1" android:scaleX="1" android:scaleY="1"
                android:translationY="0dp"/>

            <!-- moodEmoji: starts at 45% -->
            <KeyAttribute app:motionTarget="@id/moodEmoji" app:framePosition="45"
                android:alpha="0" android:translationY="80dp"/>
            <KeyAttribute app:motionTarget="@id/moodEmoji" app:framePosition="100"
                android:alpha="1" android:translationY="0dp"/>

            <!-- selectMoodButton: starts at 55% -->
            <KeyAttribute app:motionTarget="@id/selectMoodButton" app:framePosition="55"
                android:alpha="0" android:scaleX="0.9" android:scaleY="0.9"
                android:translationY="100dp"/>
            <KeyAttribute app:motionTarget="@id/selectMoodButton" app:framePosition="100"
                android:alpha="1" android:scaleX="1" android:scaleY="1"
                android:translationY="0dp"/>
        </KeyFrameSet>
    </Transition>

</MotionScene>
