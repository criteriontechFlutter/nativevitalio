<androidx.constraintlayout.motion.widget.MotionLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/motionLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient"
    app:layoutDescription="@xml/leaderboard_scene"
    tools:ignore="MissingClass">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/dashbg"
        app:navigationIcon="@drawable/ic_back"
        app:title="Leaderboard"
        android:elevation="8dp"
        app:titleTextColor="@color/themeTextColorBW"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <LinearLayout
        android:id="@+id/playerId"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginStart="10dp"
        android:gravity="center"
        android:background="@color/dashbg"
        android:layout_marginTop="6dp"

        android:orientation="horizontal">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_left"
        android:layout_width="103dp"
        android:layout_height="300dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/card_center">

        <!-- Avatar frame above the card -->
        <FrameLayout
            android:id="@+id/avatar_left"
            android:layout_width="70dp"
            android:layout_height="70dp"
            app:layout_constraintBottom_toTopOf="@+id/body_left"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:translationY="-23dp">
            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/circle_border_3"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/thirdUser"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"/>
            </FrameLayout>

            <ImageView
                android:id="@+id/badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|bottom"
                android:src="@drawable/dash_budage" />
        </FrameLayout>

        <!-- Name below avatar -->
        <TextView
            android:id="@+id/name_left"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Darrell Steward"
            android:textColor="#1E1E1E"
            android:gravity="center_horizontal"
            android:textSize="12sp"
            android:translationY="-18dp"
            app:layout_constraintTop_toBottomOf="@id/avatar_left"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Card body -->
        <androidx.cardview.widget.CardView
            android:id="@+id/body_left"
            android:layout_width="103dp"
            android:layout_height="127dp"
            android:layout_marginTop="36dp"
             app:cardCornerRadius="16dp"
            app:cardUseCompatPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:background="@drawable/medal3_p"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/medal_left"
                    android:layout_width="40dp"
                    android:layout_height="50dp"
                    android:contentDescription="medal"
                    android:src="@drawable/medal3"
                    android:translationY="-16dp" />

                <ImageView
                    android:id="@+id/gem_left"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="gem"
                    android:src="@drawable/gem" />

                <TextView
                    android:id="@+id/score_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="0"
                    android:textColor="@android:color/black"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_center"
        android:layout_width="103dp"
        android:layout_height="300dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="0dp"
        app:layout_constraintStart_toEndOf="@id/card_left"
        app:layout_constraintEnd_toStartOf="@id/card_right">

        <!-- Avatar frame above the card -->
        <FrameLayout
            android:id="@+id/avatar_center"
            android:layout_width="70dp"
            android:layout_height="70dp"
            app:layout_constraintBottom_toTopOf="@+id/body_center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:translationY="-23dp">

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/circle_border_1"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/firstUser"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"/>
            </FrameLayout>

            <ImageView
                android:id="@+id/badge_center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|bottom"
                android:src="@drawable/dash_budage" />
        </FrameLayout>

        <!-- Name below avatar -->
        <TextView
            android:id="@+id/name_center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Darrell Steward"
            android:textColor="#1E1E1E"
            android:gravity="center_horizontal"
            android:textSize="12sp"
            android:translationY="-18dp"
            app:layout_constraintTop_toBottomOf="@id/avatar_center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Card body -->
        <androidx.cardview.widget.CardView
            android:id="@+id/body_center"
            android:layout_width="103dp"
            android:layout_height="199dp"
            android:layout_marginTop="36dp"
            app:cardBackgroundColor="#FFA077"
            app:cardCornerRadius="16dp"
            app:cardUseCompatPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:background="@drawable/medal1_p"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/medal_center"
                    android:layout_width="40dp"
                    android:layout_height="50dp"
                    android:contentDescription="medal"
                    android:src="@drawable/medal1"
                    android:translationY="-46dp" />

                <ImageView
                    android:id="@+id/gem_center"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="gem"
                    android:src="@drawable/gem" />

                <TextView
                    android:id="@+id/score_center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="0"
                    android:textColor="@android:color/black"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_right"
        android:layout_width="103dp"
        android:layout_height="300dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="0dp"
        app:layout_constraintStart_toEndOf="@id/card_center"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Avatar frame above the card -->
        <FrameLayout
            android:id="@+id/avatar_right"
            android:layout_width="70dp"
            android:layout_height="70dp"
            app:layout_constraintBottom_toTopOf="@+id/body_right"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:translationY="-23dp">

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/circle_border_2"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/secondUser"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"/>
            </FrameLayout>

            <ImageView
                android:id="@+id/badge_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|bottom"
                android:src="@drawable/dash_budage" />
        </FrameLayout>

        <!-- Name below avatar -->
        <TextView
            android:id="@+id/name_right"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
             android:layout_marginBottom="8dp"
            android:gravity="center_horizontal"
            android:paddingBottom="4dp"
            android:text="Darrell Steward"
            android:textColor="#1E1E1E"
            android:textSize="12sp"
            android:translationY="-18dp"
            app:layout_constraintTop_toBottomOf="@id/avatar_right"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Card body -->
        <androidx.cardview.widget.CardView
            android:id="@+id/body_right"
            android:layout_width="103dp"
            android:layout_height="140dp"
            android:layout_marginTop="36dp"
            app:cardBackgroundColor="#77B7FF"
            app:cardCornerRadius="16dp"
            app:cardUseCompatPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:background="@drawable/medal2_p"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/medal_right"
                    android:layout_width="40dp"
                    android:layout_height="50dp"
                    android:contentDescription="medal"
                    android:src="@drawable/medal2"
                    android:translationY="-14dp" />

                <ImageView
                    android:id="@+id/gem_rights"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="gem"
                    android:src="@drawable/gem" />

                <TextView
                    android:id="@+id/score_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="0"
                    android:textColor="@android:color/black"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>


    <!-- Add player2 and player3 similarly using different constraints -->

    <!-- RecyclerView for lower ranks -->

    <LinearLayout
        android:id="@+id/playerList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:backgroundTint="@color/dashbg"
        android:background="@color/dashbg"

         android:layout_marginTop="6dp"
        android:padding="16dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playerId"
        app:layout_constraintVertical_bias="1.0"
        tools:layout_editor_absoluteX="-16dp"
        tools:ignore="ExtraText">


        android:layout_height="wrap_content"  />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_item_player"
        android:backgroundTint="#DBEAFF"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/rankText"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:text="1"
            android:textStyle="bold"
            android:gravity="center"/>

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/circle_border_3"
            android:padding="2dp">

            <ImageView
                android:id="@+id/profileImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
        </FrameLayout>
        <TextView
            android:id="@+id/nameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="User Name"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textColor="#000000" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="16sp"
            android:background="@drawable/bg_item_player"
            android:backgroundTint="@color/green" >


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You"
                android:drawablePadding="4dp"
                android:textStyle="bold"
                android:textColor="@color/white"/>

        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_item_player"
            android:backgroundTint="@color/white" >

            <ImageView
                android:id="@+id/gem_right"
                android:layout_width="21dp"
                android:layout_height="wrap_content"
                android:paddingEnd="4dp"
                android:src="@drawable/gem" />

            <TextView
                android:id="@+id/gemText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:drawablePadding="4dp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
        <View
            android:layout_width="wrap_content"
            android:layout_height="8dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/playerListdata"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
         android:background="@drawable/rounded_corners"
        android:clipToPadding="false"

        android:paddingBottom="16dp"
        android:scrollbars="vertical"  />
    </LinearLayout>

</androidx.constraintlayout.motion.widget.MotionLayout>