            <!-- Health Summary Cards -->
            <LinearLayout
                android:id="@+id/healthSnaps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="10dp"
                    android:text="Contributors"
                    android:textColor="@color/themeTextColorBW"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <include
                        android:id="@+id/totalSleepIds"
                        layout="@layout/sleep_layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/timeInBedId"
                        layout="@layout/sleep_layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <include
                        android:id="@+id/restorativeSleepId"
                        layout="@layout/sleep_layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/hr"
                        layout="@layout/sleep_layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_corners"
                android:orientation="vertical">
                <include android:id="@+id/sleepEfficiencyProgressId" layout="@layout/include_progress_card" />
                <include android:id="@+id/tempProgressId" layout="@layout/include_progress_card" />
                <include android:id="@+id/restfulnessProgressId" layout="@layout/include_progress_card" />
                <include android:id="@+id/totalSleepProgressId" layout="@layout/include_progress_card" />
                <include android:id="@+id/hrProgress" layout="@layout/include_progress_card" />
                <include android:id="@+id/restorativeSleepProgressId" layout="@layout/include_progress_card" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sleep_stages"
                android:textColor="@color/themeTextColorBW"
                android:textSize="16sp"
                android:alpha="0.8" />
               <androidx.fragment.app.FragmentContainerView
                android:id="@+id/sleepChartFragment"
                android:name="com.critetiontech.ctvitalio.UI.fragments.SleepGraphFragment"
                android:layout_width="match_parent"
                   android:background="@color/contbg"
                android:layout_height="wrap_content" />
            <!-- Header -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

                <!-- Sleep Cycle Text -->
                <TextView
                    android:id="@+id/sleepCycleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sleep Cycle 0"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:fontFamily="sans-serif-medium"/>

                <!-- Space -->
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <!-- Full Indicator -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="12dp">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/green_circle"/>

                    <TextView
                        android:id="@+id/fullText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 Full"
                        android:textSize="14sp"
                        android:textColor="#4CAF50"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>

                <!-- Partial Indicator -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/gray_circle"/>

                    <TextView
                        android:id="@+id/partialText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 Partial"
                        android:textSize="14sp"
                        android:textColor="#9E9E9E"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>

            </LinearLayout>
            <com.critetiontech.ctvitalio.utils.SleepCycleTimelineView
                android:id="@+id/sleepCycleView"
                android:layout_width="match_parent"
                android:layout_height="80dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Movement"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:alpha="0.8" />
            <LinearLayout
                xmlns:android="http://schemas.android.com/apk/res/android"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

                <!-- Left icon -->
                <ImageView
                    android:id="@+id/leftIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/icbed"
                    android:padding="6dp"
                    android:background="@drawable/circle_bg"
                    android:layout_marginEnd="8dp"/>

                <!-- Your custom graph view -->
                <com.critetiontech.ctvitalio.utils.SleepMovementGraphView
                    android:id="@+id/movementGraph"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>

                <!-- Right icon -->
                <ImageView
                    android:id="@+id/rightIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/circle_bg"
                    android:src="@drawable/ion_bed"
                    android:padding="6dp"
                    android:layout_marginStart="8dp"/>

            </LinearLayout>
            <!-- Dynamic graph area -->
            <LinearLayout
                android:id="@+id/sleepGraph"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="visible" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvTime1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="11sp"
                    android:textColor="@color/black"
                    android:gravity="start" />

                <TextView
                    android:id="@+id/tvTime2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="11sp"
                    android:textColor="@color/black"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tvTime3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="11sp"
                    android:textColor="@color/black"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tvTime4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="11sp"
                    android:textColor="@color/black"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tvTime5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="11sp"
                    android:textColor="@color/black"
                    android:gravity="end" />
            </LinearLayout>
            <!-- Movements -->
            <LinearLayout
                android:id="@+id/movementRow"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical" />

            <TextView
                android:text="Heart Rate "
                android:textSize="14sp"
                android:textColor="@color/themeTextColorBW"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <com.critetiontech.ctvitalio.UI.constructorFiles.HeartRateGraphView
                android:id="@+id/heartRateGraph"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:background="@color/contbg"
                android:elevation="4dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="16dp">

                <!-- AVG -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:gravity="center">

                    <LinearLayout
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="Avg"
                            android:textColor="#999999"
                            android:textSize="12sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginStart="4dp"
                             android:src="@drawable/ic_arrow_down" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_horizontal">
                    <TextView
                        android:id="@+id/tvAvgValue"
                        android:text=" "
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/themeTextColorBW"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#888888"
                            android:textSize="12sp" />
                </LinearLayout>
                </LinearLayout>

                <!-- MIN -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:gravity="center">

                    <LinearLayout
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="Min"
                            android:textColor="#999999"
                            android:textSize="12sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginStart="4dp"
                             android:src="@drawable/ic_arrow_down" />
                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                         android:gravity="center_horizontal">
                    <TextView
                        android:id="@+id/tvMinValue"
                        android:text="0 "
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#888888"
                            android:textSize="12sp" />
                </LinearLayout>
                </LinearLayout>

                <!-- MAX -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:gravity="center">

                    <LinearLayout
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="Max"
                            android:textColor="#999999"
                            android:textSize="12sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/arrow_right_grey" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_horizontal">
                    <TextView
                        android:id="@+id/tvMaxValue"
                        android:text=" "
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#888888"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:text="Heart Rate Variablity"
                android:textSize="14sp"
                android:textColor="#666"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <com.critetiontech.ctvitalio.UI.constructorFiles.HeartRateGraphView
                android:id="@+id/heartRateVariablityGraph"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                 android:background="@color/contbg"
                android:elevation="4dp" />
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp" >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

            <!-- Header Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="Morning Alertness"
                        android:textSize="14sp"
                        android:textColor="#666"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tvAlertnessValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 min"
                        android:textColor="#000"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAlertnessSubtitle"
                    android:text=" "
                    android:textSize="12sp"
                    android:textColor="#777"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical" />

            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <!-- Bar Chart -->
            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/alertnessBarChart"
                android:layout_width="match_parent"
                android:layout_height="180dp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="12dp" />


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/contbg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Slow Mornings?"
                        android:textColor="#E57373"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/you_ve_been_experiencing_prolonged_grogginess_that_affects_your_mornings_try_adjusting_your_bedroom_temperature_having_dinner_earlier_limiting_the_use_of_blackout_curtains_and_avoiding_coffee_late_in_the_evening"
                        android:textColor="#666666"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />
        </LinearLayout>
 <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" >

        <!-- Slow Mornings Card -->

        <!-- Tosses and Turns Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:elevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tosses and turns during sleep"

                        android:textColor="@color/themeTextColorBW"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_alignParentStart="true"/>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_dialog_info"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        app:tint="#BBBBBB"/>
                </RelativeLayout>

                <!-- Blue Info Box -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardTossTurns"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#B3E5FC">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <!-- Image -->
                        <ImageView
                            android:id="@+id/imgTurnsIcon"
                            android:layout_width="160dp"
                            android:layout_height="60dp"
                            android:src="@drawable/sleepturns"
                            android:layout_marginEnd="16dp" />

                        <!-- Text Content -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="4dp">

                                <TextView
                                    android:id="@+id/tvTurnsCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="00"
                                    android:textColor="#1565C0"
                                    android:textSize="28sp"
                                    android:textStyle="bold"/>

                                <TextView
                                    android:id="@+id/tvTurnsLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Turns"
                                    android:textColor="#1565C0"
                                    android:textSize="12sp"
                                    android:layout_marginStart="4dp"
                                    android:layout_gravity="bottom"
                                    android:layout_marginBottom="4dp"/>

                                <TextView
                                    android:id="@+id/tvTurnsDuration"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="During X hrs sleep"
                                    android:textColor="#1565C0"
                                    android:textSize="11sp"
                                    android:layout_marginStart="8dp"
                                    android:layout_gravity="center_vertical"/>
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvTurnsDescription"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="#424242"
                                android:textSize="12sp"
                                android:lineSpacingExtra="2dp"
                                android:text="Your movement patterns during sleep indicate slight restlessness"/>
                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Average Oxygen Saturation Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:elevation="0dp">

            <LinearLayout
                android:id="@+id/oxygenContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tvOxygenHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/average_oxygen_saturation"
                        android:textColor="@color/themeTextColorBW"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_alignParentStart="true"/>

                    <ImageView
                        android:id="@+id/ivOxygenInfo"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_dialog_info"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        app:tint="#BBBBBB"/>
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvOxygenLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Oxygen Saturation"

                            android:textColor="@color/textgrey"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/tvOxygenValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="86%"
                            android:textColor="@color/themeTextColorBW"
                            android:textSize="32sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvOxygenDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="During 7 hrs sleep"
                        android:textColor="#999999"
                        android:textSize="12sp"/>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/oxygenProgress"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="16dp"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:progress="0"
                    android:progressTint="#4CAF50"
                    android:progressBackgroundTint="#E0E0E0"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
    </LinearLayout>
        </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:padding="@dimen/_16sdp"
        android:background="@color/contbg"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <TextView
            android:text="Skin Temprature"
            android:textSize="14sp"
            android:textColor="@color/themeTextColorBW"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <com.critetiontech.ctvitalio.UI.constructorFiles.HeartRateGraphView
            android:id="@+id/skinTempId"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="@color/dashbg"
            android:elevation="4dp" />
    </LinearLayout>
    </LinearLayout>

</ScrollView>