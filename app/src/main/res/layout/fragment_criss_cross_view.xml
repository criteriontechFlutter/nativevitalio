<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false" >
    <ImageView
        android:id="@+id/imgGifBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <!-- Title at Top Center -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Criss Cross"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Centered imaginary square container to hold the 4 dots -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/square_container"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Top Left Dot -->
        <ImageView
            android:id="@+id/dot_top_left"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/bg_criss_cross_inactive_dot"
            android:contentDescription="Top Left Target"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Top Right Dot -->
        <ImageView
            android:id="@+id/dot_top_right"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/bg_criss_cross_inactive_dot"
            android:contentDescription="Top Right Target"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Bottom Left Dot -->
        <ImageView
            android:id="@+id/dot_bottom_left"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/bg_criss_cross_inactive_dot"
            android:contentDescription="Bottom Left Target"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Bottom Right Dot -->
        <ImageView
            android:id="@+id/dot_bottom_right"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/bg_criss_cross_inactive_dot"
            android:contentDescription="Bottom Right Target"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Line and moving target guide overlay -->
        <com.critetiontech.ctvitalio.utils.CrissCrossLineView
            android:id="@+id/criss_cross_line_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom Action & Control Bar -->

    <!-- Left: Countdown Timer -->
    <TextView
        android:id="@+id/tv_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="02:00"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="40dp"
        app:layout_constraintTop_toTopOf="@id/btn_play_pause"
        app:layout_constraintBottom_toBottomOf="@id/btn_play_pause"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Center: Play/Pause action button -->
    <ImageButton
        android:id="@+id/btn_play_pause"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:background="@drawable/bg_play_pause"
        android:src="@drawable/ic_pause"
        android:contentDescription="Play or Pause exercise session"
        android:scaleType="fitCenter"
        android:padding="20dp"
        android:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="48dp" />

    <!-- Right: End Button -->
    <TextView
        android:id="@+id/btn_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="End"
        android:textColor="@color/red_end"
        android:textSize="18sp"
        android:fontFamily="sans-serif-bold"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toTopOf="@id/btn_play_pause"
        app:layout_constraintBottom_toBottomOf="@id/btn_play_pause"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
