<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/white">
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
     android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:elevation="5dp"
        android:background="@color/primaryBlueLight"
        android:orientation="vertical">

        <!-- Header: Arrow + Text -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadingEdgeLength="@dimen/_14sdp"
            android:elevation="@dimen/_5sdp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="0dp">

            <ImageView
                android:id="@+id/wellnessImageArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/wellnessText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Challenge Details"
                android:textSize="18sp"
                android:paddingStart="16dp"
                android:textColor="@android:color/black" />

        </LinearLayout>


    </LinearLayout>
<androidx.cardview.widget.CardView
    android:id="@+id/cardViewid"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="18dp"
    android:background="@drawable/bg_box"
    app:cardElevation="0dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_box">

        <!-- Title Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iconGoal"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/octicon_goal"
                 android:layout_marginEnd="8dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Glucose Stability Week"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#111111"/>

                <TextView
                    android:id="@+id/subtitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="w/Coach Sarah | 7 days"
                    android:textSize="12sp"
                    android:textColor="#777777"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Progress Text -->
        <TextView
            android:id="@+id/labelCurrent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Progress 0%"
            android:textSize="12sp"
            android:textColor="#444444"
            android:layout_marginTop="12dp"/>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="70"
            android:progressDrawable="@drawable/progress_drawable"/>

        <!-- Streak Row -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:paddingTop="4.dp"
            android:background="#FFFFFF">

            <!-- Consistency wins! text -->
            <TextView
                android:id="@+id/tvConsistencyWins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Consistency wins!"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FF6F07"
                android:layout_marginEnd="16dp" />

            <!-- Day indicators container -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="17.dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Monday -->
                <TextView
                    android:id="@+id/tvMonday"
                    android:layout_width="23dp"
                    android:layout_height="32dp"
                    android:text="M"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FF6B35"
                    android:gravity="center"
                    android:background="@drawable/day_circle_background"  />

                <!-- Tuesday -->
                <TextView
                    android:id="@+id/tvTuesday"
                    android:layout_width="23dp"
                    android:layout_height="32dp"
                    android:text="T"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FF6B35"
                    android:gravity="center"
                    android:background="#FFE5D9"  />

                <!-- Wednesday -->
                <TextView
                    android:id="@+id/tvWednesday"
                    android:layout_width="23dp"
                    android:layout_height="32dp"
                    android:text="W"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FF6B35"
                    android:gravity="center"
                    android:background="#FFE5D9"  />

                <!-- Thursday -->
                <TextView
                    android:id="@+id/tvThursday"
                    android:layout_width="23dp"
                    android:layout_height="32dp"
                    android:text="T"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FF6B35"
                    android:gravity="center"
                    android:background="#FFE5D9" />

                <!-- Friday -->
                <TextView
                    android:id="@+id/tvFriday"
                    android:layout_width="23dp"
                    android:layout_height="32dp"
                    android:text="F"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FF6B35"
                    android:gravity="center"
                    android:background="#FFE5D9"  />

                <!-- Fire emoji/icon -->
                <TextView
                    android:id="@+id/tvFireIcon"
                    android:layout_width="23dp"
                    android:layout_height="32dp"
                    android:text="🔥"
                    android:background="#FFE5D9"
                    android:textSize="20sp"
                    android:gravity="center"  />

                <!-- Saturday -->
                <TextView
                    android:id="@+id/tvSaturday"
                    android:layout_width="23dp"
                    android:layout_height="32dp"
                    android:text="S"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#999999"
                    android:gravity="center"
                    android:layout_marginEnd="0dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Reminder Box -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!--            <ImageView-->
            <!--                android:id="@+id/iconReminder"-->
            <!--                android:layout_width="16dp"-->
            <!--                android:layout_height="16dp"-->
            <!--                android:src="@drawable/clock"-->
            <!--                android:layout_marginEnd="6dp" />-->

            <TextView
                android:id="@+id/reminderText"
                android:layout_width="match_parent"
                android:padding="12dp"
                android:layout_height="wrap_content"
                android:background="@drawable/dashboard_rounded_corner"

                android:text="Tiny push needed — one smooth glucose day completes your streak."
                android:textSize="12sp"
                android:textColor="#444444" />
        </LinearLayout>


        <TextView
            android:id="@+id/discriptions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" "
            android:textSize="12sp"
            android:textColor="#777777"
            android:layout_marginTop="2dp"/>
        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_log_reading"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Log reading"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@android:color/white"
                app:backgroundTint="#007BFF"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_log"
                app:iconPadding="6dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_message_coach"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:text="Message Coach"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="#007BFF"
                app:backgroundTint="#EAF3FF"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_chat"
                app:iconPadding="6dp"
                app:iconTint="#007BFF"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>


