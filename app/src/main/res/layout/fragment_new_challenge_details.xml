        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Progress"
            android:textSize="16sp"
            android:layout_marginLeft="16.dp"
            android:textColor="#111111"
            android:textStyle="bold" />
    <LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <!-- Left Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_box"
            android:padding="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Days left"
                android:textSize="12sp"
                android:textColor="#858181"
                android:textStyle="bold" />
            <LinearLayout
                android:id="@+id/leftBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:layout_marginEnd="8dp">
            <TextView
                android:id="@+id/dayLeftId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/0 "
                android:textSize="16sp"
                android:textColor="#111111"
                android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Days left"
                    android:textSize="12sp"
                    android:textColor="#858181"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvDaysLeftStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Good"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_badge_green"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>


    </LinearLayout>


    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@android:color/white"
        android:layout_margin="12dp"
        android:elevation="2dp">

        <!-- Title and Days Left -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Glucose Stability Status"
                android:textColor="#333"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDaysLefts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4/7 Days"
                android:textSize="12sp"
                android:textColor="#999" />
        </LinearLayout>

        <!-- Glucose Range -->
        <TextView
            android:id="@+id/tvGlucoseRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="95–99 mg/dL"
            android:textSize="18sp"
            android:textColor="#111"
            android:textStyle="bold" />

        <!-- Chart with Y-axis and center line -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:background="@android:color/white">

            <!-- Y axis -->
            <LinearLayout
                android:id="@+id/yAxisContainer"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical|end"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/tvMaxValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="140"
                    android:textSize="10sp"
                    android:textColor="#999"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvMidValue"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="90"
                    android:textSize="10sp"
                    android:textColor="#999"
                    android:gravity="center_vertical"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvMinValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="40"
                    android:textSize="10sp"
                    android:textColor="#999"
                    android:textStyle="bold"/>
            </LinearLayout>


            <!-- Chart Area -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <!-- Bars -->
                <LinearLayout
                    android:id="@+id/barChartContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="bottom"/>


                <!-- Center band (80-100 range) -->
                <View
                    android:id="@+id/centerLine"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:background="#1A00D492"/>


                <!-- Dates inside band -->


            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/xAxisDates"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center"/>
    </LinearLayout>
    </LinearLayout>

    </LinearLayout>


</ScrollView>