<?xml version="1.0" encoding="utf-8"?>
    <layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F5F6F8">

            <!-- Gym Card -->
            <LinearLayout
                android:id="@+id/gymCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_margin="16dp">

                <TextView
                    android:id="@+id/tvGymName"
                    android:text="FitZone Express"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#000" android:layout_height="wrap_content" android:layout_width="wrap_content"/>

                <TextView
                    android:id="@+id/tvAddress"
                    android:text="123 MG Road, Bengaluru"
                    android:textSize="12sp"
                    android:layout_height="wrap_content" android:layout_width="wrap_content"
                    android:textColor="#777"/>

            </LinearLayout>

            <!-- Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:text="Scan QR to Check In"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_height="wrap_content" android:layout_width="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/gymCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Camera Preview -->
            <androidx.camera.view.PreviewView
                android:id="@+id/previewView"
                android:layout_width="0dp"
                android:layout_height="300dp"
                android:background="#000"
                android:layout_margin="20dp"
                app:layout_constraintTop_toBottomOf="@id/tvTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Instruction -->
            <TextView
                android:id="@+id/tvInstruction"
                android:text="Position QR code in frame"
                android:textSize="14sp"
                android:textColor="#1A73E8"
                android:layout_height="wrap_content" android:layout_width="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/previewView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:text="Scan the gym QR code to confirm your visit"
                android:textSize="12sp"
                android:textColor="#777"
                android:layout_height="wrap_content" android:layout_width="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/tvInstruction"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </layout>
