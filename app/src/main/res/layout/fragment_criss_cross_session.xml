<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fillViewport="true"
    android:background="#F5F6F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Success Icon -->
        <ImageView
            android:id="@+id/imgSuccess"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginTop="50dp"
            android:src="@drawable/ic_success"
            android:background="@drawable/bg_success_circle"
            android:padding="20dp" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Great Work!"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginTop="20dp"/>

        <!-- Description -->
        <TextView
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:text="You've completed 0 sets of Criss-Cross Focus exercises. Your eyes should feel refreshed!"
            android:textAlignment="center"
            android:textColor="#666666"
            android:textSize="14sp"
            android:layout_marginTop="10dp"/>

        <!-- Time -->
        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="05 mins"
            android:textStyle="bold"
            android:textSize="30sp"
            android:textColor="#222222"
            android:layout_marginTop="30dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Session time"
            android:textColor="#888888"
            android:textSize="14sp"/>

        <!-- Eye Care Tip Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_tip_card"
            android:padding="16dp"
            android:layout_marginTop="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 Eye Care Tip"
                android:textStyle="bold"
                android:textColor="#444444"
                android:textSize="16sp"
                android:layout_gravity="center"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Remember the 20-20-20 rule: Every 20 minutes, look at something 20 feet away for 20 seconds."
                android:textAlignment="center"
                android:textColor="#666666"
                android:textSize="13sp"
                android:layout_marginTop="10dp"/>
        </LinearLayout>

        <!-- Start Again -->
        <Button
            android:id="@+id/btnStartAgain"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="30dp"
            android:text="Start Again"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:backgroundTint="#1877F2"
            android:background="@drawable/bg_primary_button"/>

        <!-- Choose Different Exercise -->
        <Button
            android:id="@+id/btnDifferentExercise"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="15dp"
            android:text="Choose Different Exercise"
            android:textAllCaps="false"
            android:textColor="#1A73E8"

            app:backgroundTint="#FFFFFF"
            android:background="@drawable/bg_outline_button"/>

    </LinearLayout>

</ScrollView>