<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent" >
    <ImageView
        android:id="@+id/imgGifBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <!-- Title at Top Center -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Clock Circle"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Centered Custom Clock Circle View -->
    <com.critetiontech.ctvitalio.utils.ClockCircleView
        android:id="@+id/clock_circle_view"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Centered Countdown outline ring & text -->
    <TextView
        android:id="@+id/tv_countdown"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_countdown_circle"
        android:gravity="center"
        android:text="3"
        android:textColor="@color/white"
        android:textSize="44sp"
        android:fontFamily="sans-serif-medium"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Focus Guide (Focus Near / Focus Far) -->
    <TextView
        android:id="@+id/tv_focus_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/clock_circle_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Subtitle description -->
    <TextView
        android:id="@+id/tv_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Keep your head still while focusing on the red dot with your eyes as it moves clockwise and anti-clockwise."
        android:textColor="@color/whiteDull"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintTop_toBottomOf="@id/tv_focus_guide"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Action & Control Bar -->

    <!-- Left: Reverse Countdown Timer -->
    <TextView
        android:id="@+id/tv_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="02:00"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="40dp"
        app:layout_constraintTop_toTopOf="@id/btn_play_pause"
        app:layout_constraintBottom_toBottomOf="@id/btn_play_pause"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Center: Play/Pause action button -->
    <ImageButton
        android:id="@+id/btn_play_pause"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:background="@drawable/bg_play_pause"
        android:src="@drawable/ic_pause"
        android:contentDescription="Play or Pause exercise session"
        android:scaleType="fitCenter"
        android:padding="20dp"
        android:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="48dp" />

    <!-- Right: End Button -->
    <TextView
        android:id="@+id/btn_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="End"
        android:textColor="@color/red"
        android:textSize="18sp"
        android:fontFamily="sans-serif-bold"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toTopOf="@id/btn_play_pause"
        app:layout_constraintBottom_toBottomOf="@id/btn_play_pause"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
