<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8.dp"
    card_view:cardCornerRadius="16dp"
    card_view:cardElevation="0dp"
    android:background="@color/contbg"
    android:backgroundTint="@color/contbg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imgIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#E3F2FD"
                android:padding="8dp"
                android:src="@drawable/challege_icons"
                android:scaleType="centerInside"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stress Less Living"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/themeTextColorBW"/>


                <TextView
                    android:id="@+id/tvDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="14.dp"
                    android:text="w/ Care Team | 30 days"
                    android:textSize="12sp"
                    android:textColor="@color/textgrey"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tvDays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 days to go"
                android:textSize="12sp"
                android:textColor="#2979FF"/>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/textgrey"
            android:layout_marginVertical="8dp"/>

        <!-- Sub Info -->
        <!-- Bottom Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/tvPeople"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="People Joined"
                android:textSize="11sp"
                android:textColor="#999"/>

            <Button
                android:id="@+id/btnJoin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Join Now"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1E88E5"
                android:layout_alignParentEnd="true"
                android:paddingStart="12dp"
                android:padding="0.dp"
                android:paddingEnd="12dp"/>
        </RelativeLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>